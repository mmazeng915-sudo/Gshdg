<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<title>نعم يا ماما 😂</title>
<style>
    body{
        background:#f9f9f9;
        font-family:Tahoma, Arial;
        display:flex;
        flex-direction:column;
        justify-content:center;
        align-items:center;
        height:100vh;
        margin:0;
        text-align:center;
    }
    h1{margin-bottom:20px;}
    input{
        padding:10px;
        width:250px;
        font-size:18px;
        border-radius:8px;
        border:1px solid #999;
        outline:none;
    }
    button{
        margin-top:15px;
        padding:10px 25px;
        font-size:18px;
        border:none;
        border-radius:8px;
        cursor:pointer;
        background:#4CAF50;
        color:white;
        transition:0.2s;
    }
    button:disabled{
        background:#777;
        cursor:not-allowed;
    }
    #result{margin-top:25px;font-size:22px;font-weight:bold;}
    .shake{
        animation:shake .3s;
    }
    @keyframes shake{
        0%{transform:translateX(0);}
        25%{transform:translateX(-8px);}
        50%{transform:translateX(8px);}
        75%{transform:translateX(-8px);}
        100%{transform:translateX(0);}
    }
</style>
</head>
<body>

<audio id="knockSound">
    <source src="https://www.soundjay.com/door/sounds/door-knock-1.mp3" type="audio/mpeg">
</audio>

<h1>يا واد يا دقدق؟ 😏</h1>
<p>اكتب الرد الصح وورّينا أدبك</p>

<input type="text" id="userInput" placeholder="اكتب هنا...">
<button onclick="check()">رد</button>
<div id="result"></div>

<script>
let mistakes = 0;

function check(){
    const input = document.getElementById("userInput").value.trim();
    const result = document.getElementById("result");
    const btn = document.querySelector("button");
    const body = document.body;
    
    if(input === ""){
        result.innerHTML = "اكتب حاجة الأول يا نجم! 🤦‍♂️";
        return;
    }

    if(input === "نعم يا ماما"){
        document.getElementById("knockSound").play();
        result.innerHTML = "الـباب بيخبط! 🚪";
        setTimeout(()=>{ result.innerHTML = "تيتة جت! 👵🎉"; },1200);
        mistakes = 0;
    } 
    else {
        mistakes++;
        if(mistakes < 3){
            const funny = [
                "ده رد لجارتكم؟ ركّز يا حبيب ماما 😂",
                "يا ابني دي مش قصه حياة... اكتبها صح!",
                "قريب... بس لسه مش عريس مناسب 🤣"
            ];
            result.innerHTML = funny[Math.floor(Math.random()*funny.length)];
        } else {
            body.classList.add("shake");
            result.innerHTML = "3 مرات غلط! أنا زعلت 😒 ركّن الكبرياء وتعالى من الأول!";
            btn.disabled = true;
            setTimeout(()=>{
                body.classList.remove("shake");
                btn.disabled = false;
                result.innerHTML = "جرب تاني يا شاطر 👀";
                mistakes = 0;
            }, 3000);
        }
    }

    document.getElementById("userInput").value = "";
}
</script>

</body>
</html>
